# Copy this file to .env and fill in your own values.

# Used when running the app locally (mvnw spring-boot:run).
# When running with docker compose, DB_URL is overridden to point at the todo-db container.
DB_URL=jdbc:postgresql://localhost:5432/todo_db

# Also used by docker compose to create the Postgres user
DB_USERNAME=postgres
DB_PASSWORD=change_me

# Secret key for signing JWTs. Must be Base64 and decode to at least 32 bytes.
# Generate one with: openssl rand -base64 32
JWT_SECRET=

# First admin account, created on startup if it does not exist yet
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me
